{
  "name": "techno",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "build": { "command": "node scripts/build-site.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "durable_objects": { "bindings": [{ "name": "EVALUATIONS", "class_name": "EvaluationStore" }] },
  "migrations": [{ "tag": "evaluations-v1", "new_sqlite_classes": ["EvaluationStore"] }]
}
